<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.lennylxx.inputmethod.GboardIME</string>
    <key>CFBundleName</key>
    <string>GboardIME</string>
    <key>CFBundleDisplayName</key>
    <string>Gboard</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleExecutable</key>
    <string>GboardIME</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!-- IMKit keys -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>InputMethodServerControllerClass</key>
    <string>GboardInputController</string>
    <key>InputMethodConnectionName</key>
    <string>GboardIME_Connection</string>

    <!-- Input modes dictionary for macOS System Settings discovery -->
    <key>ComponentInputModeDict</key>
    <dict>
        <key>tsInputModeListKey</key>
        <dict>
            <key>com.lennylxx.inputmethod.GboardIME</key>
            <dict>
                <key>tsInputModeDefaultStateKey</key>
                <true/>
                <key>tsInputModeIsVisibleKey</key>
                <true/>
                <key>tsInputModePrimaryInScriptKey</key>
                <true/>
                <key>tsInputModeScriptKey</key>
                <string>smSimpChinese</string>
            </dict>
        </dict>
        <key>tsVisibleInputModeOrderedArrayKey</key>
        <array>
            <string>com.lennylxx.inputmethod.GboardIME</string>
        </array>
    </dict>

    <!-- Character repertoire — top level, makes it appear under Chinese Simplified -->
    <key>tsInputMethodCharacterRepertoireKey</key>
    <array>
        <string>Hans</string>
    </array>
    <key>TICapsLockLanguageSwitchCapable</key>
    <true/>

    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
</dict>
</plist>
